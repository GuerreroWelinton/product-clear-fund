// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  cashFundAssignments CashFundUser[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// F02 - Cash fund lifecycle.
enum CashFundStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

// F02 - A cash fund (caja de ahorro): its structural parameters and mutable
// operational config. Each fund operates in USD with its own balance,
// numbering, loans and closings (BR-F02-001).
model CashFund {
  id   String @id @default(uuid())
  name String

  // Structural parameters, locked once the fund is activated (BR-F02-002/004).
  logoKey             String?
  phrase              String?
  currency            String    @default("USD")
  monthlySavingAmount Decimal   @db.Decimal(18, 2)
  officialStartDate   DateTime? @db.Date

  status CashFundStatus @default(DRAFT)

  // Consecutive member number per fund; the "first number" seam for F05.
  nextMemberNumber Int @default(1)

  // Operational config, editable while ACTIVE (BR-F02-005).
  recommendedDay   Int
  maximumDay       Int
  maxAdvanceMonths Int
  riskThreshold    Int

  // Lifecycle tracking; deactivatedAt anchors the reactivation recovery (F06 seam, BR-F02-007).
  activatedAt   DateTime?
  deactivatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments CashFundUser[]

  @@index([status])
  @@map("cash_fund")
}

// F02 creates this table (grouped with CashFund in PRISMA_SCHEMA_PLAN.md) and
// reads active assignments to authorize treasurer config edits (FR-F02-002).
// Assignment management (assign/revoke) belongs to F03.
model CashFundUser {
  id         String @id @default(uuid())
  cashFundId String
  userId     String
  status     String @default("ACTIVE") // ACTIVE | REVOKED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cashFund CashFund @relation(fields: [cashFundId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cashFundId, userId])
  @@index([userId])
  @@index([cashFundId])
  @@map("cash_fund_user")
}

// F23 - Append-only audit trail: who did what, when, over which fund or entity
// (BR-F23-002). Immutability (BR-F23-003) is enforced in the database by a
// BEFORE UPDATE OR DELETE trigger added in the migration, not only by the
// absence of update/delete use cases.
//
// Deliberately has NO foreign keys (ADR-013): a cascade would destroy history
// and a SET NULL would be rejected by the immutability trigger. Actor and fund
// are stored as plain ids plus a readable snapshot taken at event time.
model AuditEvent {
  id String @id @default(uuid())

  // Actor snapshot. Nullable so a future system/job actor (F24) can be recorded
  // without a user row. actorEmail/actorRole freeze who the actor WAS.
  actorId    String?
  actorEmail String?
  actorRole  String?

  occurredAt DateTime @default(now())

  // Null for global events such as USER_CREATED (spec edge case "evento sin
  // caja"). Only a Super Admin can read global events.
  cashFundId String?

  // What the event is about, e.g. ("USER", <userId>) or ("CASH_FUND", <fundId>).
  entityType String
  entityId   String

  // AuditEventType. Stored as String, validated by the TS literal union at the
  // module boundary, so future features add types without a migration (ADR-013).
  action String

  // Free-text motive when the operation carries one (e.g. a ban reason).
  reason String?

  // Field-level diff, already redacted (BR-F23-004):
  // { "<field>": { "previous": <json>, "next": <json> } }
  changes Json?

  // BR-F23-005 seam: relatedEventId points at the event this one reverses or
  // derives from; correlationId groups every event of one business operation.
  // Populated by F09/F20 once financial operations exist.
  relatedEventId String?
  correlationId  String?

  @@index([cashFundId, occurredAt])
  @@index([occurredAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([correlationId])
  @@map("audit_event")
}
